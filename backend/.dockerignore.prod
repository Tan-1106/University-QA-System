# Production Docker build ignore file
# Includes application source in build context

# Python cache and build output
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.build/
dist/
build/
.eggs/
*.egg-info/

# Virtual environments and caches
.venv/
venv/
.pytest_cache/
.mypy_cache/
.cache/

# VCS and editor settings
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files (use env_file in docker-compose instead)
.env
.env.*

# Logs and temporary files
*.log
*.tmp
*.temp
/tmp/

# Development and testing files
tests/
test_*.py
*_test.py
conftest.py
pytest.ini
.coverage
htmlcov/

# Documentation and README files
README.md
docs/
*.md

# Development Docker files
Dockerfile.dev
docker-compose.dev.yml

# Runtime data directories (will be mounted as volumes)
uploads/
chroma_data/
mongo_data/

# Large cache directories
hf_cache/
.cache/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini